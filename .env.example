# Copie para .env.local e ajuste. Tudo é opcional: sem nada, o app abre com dados de demonstração.

# De onde vêm as previsões. Vazio = demonstração.
#   /api                    → em desenvolvimento: o Vite repassa para o backend (não depende de CORS)
#   http://localhost:8080   → direto no backend (precisa de CORS liberado lá)
VITE_API_URL=

# Força a demonstração mesmo com VITE_API_URL preenchido (o mesmo que npm run demo).
# VITE_DEMO=1

# Para onde o atalho /api repassa (padrão: http://localhost:8080). Só vale em npm run dev / preview.
# SIMA_BACKEND=http://localhost:8080

# De quantos em quantos segundos o app consulta as previsões de novo (padrão: 90).
# VITE_INTERVALO_S=90

# Servidor de tiles do mapa, no esquema OpenMapTiles (padrão: OpenFreeMap, gratuito e sem chave).
# VITE_MAPA_TILES=https://tiles.openfreemap.org/planet
# VITE_MAPA_GLIFOS=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf

# Rotas de carro (Valhalla) e busca de endereço (Photon). Padrão: servidores públicos, sem chave.
# VITE_ROTAS_URL=https://valhalla1.openstreetmap.de
# VITE_ENDERECOS_URL=https://photon.komoot.io
